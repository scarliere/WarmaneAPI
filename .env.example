# Example settings. Export these variables before starting the server.
# .env files are not automatically loaded by Uvicorn.
WARMANE_CACHE_TTL_SECONDS=60
WARMANE_HTML_CACHE_TTL_SECONDS=300
WARMANE_MIN_INTERVAL_SECONDS=4
WARMANE_TIMEOUT_SECONDS=15
# Comma-separated frontend origins; empty disables cross-origin browser access.
CORS_ORIGINS=
